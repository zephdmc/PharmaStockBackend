{
    "name": "pharmacy-inventory-backend",
    "version": "1.0.0",
    "description": "Backend API for Pharmacy Inventory Management System",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "dev:debug": "nodemon --inspect server.js",
        "test": "jest --coverage",
        "test:watch": "jest --watch",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "format": "prettier --write src/",
        "db:seed": "node scripts/seed.js",
        "db:reset": "node scripts/reset.js",
        "backup": "node scripts/backup.js",
        "restore": "node scripts/restore.js"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "chalk": "^4.1.2",
        "compression": "^1.7.4",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "crypto": "^1.0.1",
        "dotenv": "^16.6.1",
        "express": "^4.22.1",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^6.10.0",
        "express-validator": "^7.0.1",
        "helmet": "^7.0.0",
        "jsonwebtoken": "^9.0.2",
        "moment": "^2.29.4",
        "mongoose": "^7.5.0",
        "mongoose-paginate-v2": "^1.7.4",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^6.9.5",
        "pdfkit": "^0.14.0",
        "qrcode": "^1.5.3",
        "uuid": "^9.0.0",
        "winston": "^3.10.0",
        "xss-clean": "^0.1.1"
    },
    "devDependencies": {
        "eslint": "^8.49.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-plugin-import": "^2.28.1",
        "faker": "^5.5.3",
        "jest": "^29.6.4",
        "nodemon": "^3.0.1",
        "prettier": "^3.0.3",
        "supertest": "^6.3.3"
    },
    "jest": {
        "testEnvironment": "node",
        "coveragePathIgnorePatterns": [
            "/node_modules/",
            "/tests/fixtures/"
        ],
        "testMatch": [
            "**/__tests__/**/*.js",
            "**/?(*.)+(spec|test).js"
        ]
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    }
}
